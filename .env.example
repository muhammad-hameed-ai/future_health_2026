# ==============================================================================
# SkinGuard AI • Environment Variables Template (.env.example)
# Future Health Digital Innovation Challenge 2026
# ==============================================================================

# Google Gemini API Key (Required for Clinical RAG & NICE NG12 embeddings)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key (Used for on-device token signing)
AUTH_SECRET_KEY=skinguard-uae-futurehealth-secret-key-2026

# Optional: Path to local Qdrant vector database storage
QDRANT_PATH=local_qdrant_data

# Optional: Production Host & Port
HOST=0.0.0.0
PORT=8000
